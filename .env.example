# Backend mà app gọi tới.
#
# `NEXT_PUBLIC_` là BẮT BUỘC: app build ở chế độ `output: "export"` nên không có
# server runtime nào đọc env lúc chạy — giá trị được nhúng vào bundle lúc build,
# và một biến không mang tiền tố này sẽ là `undefined` trên trình duyệt.
#
# 1133 là cổng docker-compose mở API ra host (WorkSpace_BE/.env → API_PORT_HOST).
# Next dev giữ 3311, nên hai bên không giẫm chân nhau.
#
# Đổi giá trị này thì phải BUILD LẠI — `next dev` đọc lúc khởi động, không nóng.
NEXT_PUBLIC_API_URL=http://localhost:1133
